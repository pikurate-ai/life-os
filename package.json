{
  "name": "life-os",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "predev": "node scripts/generate-icons.cjs",
    "prebuild": "node scripts/generate-icons.cjs",
    "build": "next build",
    "start": "node scripts/serve.cjs",
    "preview": "node scripts/serve.cjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test --test-isolation=none tests/*.test.mjs && node scripts/test-health-vault.cjs",
    "check": "npm run typecheck && npm test && npm run build",
    "format": "prettier --write src/components/life-os src/lib/life-os src/app docs scripts tests public/sw.js AGENTS.md PROJECT_HANDOVER.md PROJECT_STATE.md README.md next.config.ts package.json .github/workflows",
    "format:check": "prettier --check src/components/life-os src/lib/life-os src/app docs scripts tests public/sw.js AGENTS.md PROJECT_HANDOVER.md PROJECT_STATE.md README.md next.config.ts package.json .github/workflows"
  },
  "dependencies": {
    "@capacitor/ios": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.49.1",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "lucide-react": "^1.16.0",
    "next": "15.5.28",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@tailwindcss/postcss": "^4.0.9",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "postcss": "^8.5.3",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.8.2"
  }
}
