# Firebase Web App configuration — copy to .env.local, then rebuild.
# These are public project identifiers; access is protected by Firebase Auth and firestore.rules.
# No private service-account key belongs in NEXT_PUBLIC_* or browser source.
# All six values are required. Leaving any blank disables cloud login/sync.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
